# Copy to .env.local, which git ignores. In dev the keys screen fills empty fields from it, and
# the scripts read it. A deployed page asks each visitor for their own keys and keeps them in
# their browser.

# Reactor: the FastH3-Omni video sessions. Required.
REACTOR_API_KEY=

# OpenAI: the agent that keeps the world's state and writes new scenarios. Required.
OPENAI_API_KEY=

# TypeSafe: Jev, which finds every clickable thing in a frame. Required.
TYPESAFE_API_KEY=

# Art for written scenarios and the busy state, and predicted stills. Optional.
FAL_KEY=

# Hosted play only, read by `pnpm run deploy --secrets`: fal's production key (never FAL_KEY)
# and the secret key of the deployment's Turnstile widget.
FAL_PRODUCTION_KEY=
TURNSTILE_SECRET_KEY=

# OpenRouter: the Gemini judges in the eval and payoff scripts. Optional, scripts only.
OPENROUTER_API_KEY=
